local viewport = workspace.CurrentCamera.ViewportSize


local function safeSize(pxWidth, pxHeight)
    local scaleX = pxWidth / viewport.X
    local scaleY = pxHeight / viewport.Y
    if isMobile then
        if scaleX > 0.78 then scaleX = 0.78 end
        if scaleY > 0.85 then scaleY = 0.85 end
    else
        if scaleX > 0.65 then scaleX = 0.65 end
        if scaleY > 0.85 then scaleY = 0.85 end
    end
    return UDim2.new(scaleX, 0, scaleY, 0)
end

local function resolveScaledPixelSize(scaleUDim, minW, minH, maxW, maxH)
    local w = math.clamp(scaleUDim.X.Scale * viewport.X, minW, maxW)
    local h = math.clamp(scaleUDim.Y.Scale * viewport.Y, minH, maxH)
    return math.floor(w), math.floor(h)
end

