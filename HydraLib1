                CloseBtn.TextColor3 = C_SUBTEXT
                CloseBtn.Font = Enum.Font.GothamBold
                CloseBtn.TextSize = 14
                CloseBtn.ZIndex = 33
                CloseBtn.Parent = DropPanel

                local function IsSelected(value)
                    if DropdownConfig.Multi then
                        for _, v in ipairs(DropdownFunc.Value or {}) do
                            if v == value then return true end
                        end
                        return false
                    end
                    return DropdownFunc.Value == value
                end

                local function CurrentLabel()
                    if DropdownConfig.Multi then
                        local n = #(DropdownFunc.Value or {})
                        return n == 0 and (DropdownConfig.Multi and "Select Options" or "Select Option") or (n .. " selected")
                    end
                    return DropdownFunc.Value ~= nil and tostring(DropdownFunc.Value) or (DropdownConfig.Multi and "Select Options" or "Select Option")
                end

                local function Persist()
                    if not shouldSave then return end
                    ConfigData[configKey] = DropdownFunc.Value
                    QueueSaveConfig()
                end

                local function RefreshOptions()
                    for _, child in ipairs(DropScroll:GetChildren()) do
                        if child:IsA("Frame") then child:Destroy() end
                    end
                    local query = string.lower(DropSearch.Text)
                    local order = 0
                    for _, opt in ipairs(DropdownFunc.Options) do
                        local label = tostring(opt)
                        if query == "" or string.find(string.lower(label), query, 1, true) then
                            order = order + 1
                            local isSel = IsSelected(opt)

                            local Row = Instance.new("TextButton")
                            Row.Font = Enum.Font.GothamBold
                            Row.Text = label
                            Row.TextColor3 = isSel and GuiConfig.Color or C_TEXT
                            Row.TextSize = 12
                            Row.TextXAlignment = Enum.TextXAlignment.Left
                            Row.BackgroundColor3 = isSel and GuiConfig.Color or C_PANEL2
                            Row.BackgroundTransparency = isSel and 0.82 or 0
                            Row.Size = UDim2.new(1, 0, 0, 30)
                            Row.LayoutOrder = order
                            Row.ZIndex = 32
                            Row.Parent = DropScroll
                            corner(Row, 5)
                            pad(Row, 10, 0, 0, 0)
                            local rowStroke = stroke(Row, isSel and GuiConfig.Color or C_BORDER, 1)
                            rowStroke.ZIndex = 32

                            Row.Activated:Connect(function()
                                if DropdownConfig.Multi then
                                    local found = false
                                    for i, v in ipairs(DropdownFunc.Value) do
                                        if v == opt then
                                            table.remove(DropdownFunc.Value, i)
                                            found = true
                                            break
                                        end
                                    end
                                    if not found then table.insert(DropdownFunc.Value, opt) end
                                    RefreshOptions()
                                    OptionSelecting.Text = CurrentLabel()
                                    Persist()
                                    local ok, err = pcall(function() DropdownConfig.Callback(DropdownFunc.Value) end)
                                    if not ok then warn("Dropdown Callback error:", err) end
                                else
                                    DropdownFunc.Value = opt
                                    OptionSelecting.Text = CurrentLabel()
                                    DropdownOverlay.Visible = false
                                    Persist()
                                    local ok, err = pcall(function() DropdownConfig.Callback(DropdownFunc.Value) end)
                                    if not ok then warn("Dropdown Callback error:", err) end
                                end
                            end)
                        end
                    end
                end

                DropdownButton.Activated:Connect(function()
                    DropdownOverlay.Visible = true
                    DropSearch.Text = ""
                    RefreshOptions()
                end)
                CloseBtn.Activated:Connect(function()
                    DropdownOverlay.Visible = false
                end)

                local dropSearchTicket = 0
                DropSearch:GetPropertyChangedSignal("Text"):Connect(function()
                    dropSearchTicket = dropSearchTicket + 1
                    local ticket = dropSearchTicket
                    task.delay(0.08, function()
                        if ticket == dropSearchTicket then RefreshOptions() end
                    end)
                end)

                function DropdownFunc:Set(value, noSave)
                    DropdownFunc.Value = value
                    OptionSelecting.Text = CurrentLabel()
                    if shouldSave and not noSave then Persist() end
                end
                function DropdownFunc:SetOptions(list)
                    DropdownConfig.Options = list or {}
                    DropdownFunc.Options = DropdownConfig.Options
                    RefreshOptions()
                end

                OptionSelecting.Text = CurrentLabel()
                CountItem = CountItem + 1
                if shouldSave then Elements[configKey] = DropdownFunc end
                RegisterSearch({ label = DropdownConfig.Title, tab = TabConfig.Name, kind = "Dropdown", switch = SearchSwitch })
                return DropdownFunc
            end

